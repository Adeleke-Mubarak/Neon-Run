                android:endY="50">
                <item android:offset="0.0" android:color="#00FF007F" />
                <item android:offset="1.0" android:color="#EEFF007F" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Speed Trail 3 - Cyan Lower Drive Streak -->
    <path
        android:pathData="M24,57 L45,57 L41,60 L24,60 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
