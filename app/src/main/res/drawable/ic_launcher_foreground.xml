    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF007F"
        android:strokeWidth="1.2"
        android:pathData="M52,81 L52,76 L56,76 C57.5,76 57.5,78.5 56,78.5 L52,78.5 M55,78.5 L57,81" />

