            <gradient
                android:type="linear"
                android:startX="22"
                android:startY="40.5"
                android:endX="47"
                android:endY="40.5">
                <item android:offset="0.0" android:color="#0000F0FF" />
                <item android:offset="1.0" android:color="#CC00F0FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Speed Trail 2 - Magenta Core Burst Streak -->
    <path
        android:pathData="M18,48 L50,48 L46,52 L18,52 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="50"
